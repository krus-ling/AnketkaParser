# ==============================================================================
# AnketkaParser - Файл конфигурации переменных окружения (.env)
# Скопируйте этот файл в .env и настройте под ваше окружение
# ==============================================================================

# --- Профиль респондента и база SQLite ---
PROFILE_PATH=data/profile.json
DB_PATH=data/survey_memory.db

# --- Настройки основной LLM (Ollama / Local / OpenAI-совместимый API) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:14b
LLM_TIMEOUT=25.0

# --- Настройки Vision API (Google Gemini Free Tier для капч и картинок) ---
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VISION_API_KEY=your_gemini_api_key_here
VISION_MODEL=gemini-2.5-flash

# --- Прокси для обращения к Google Gemini (если доступ к Gemini заблокирован) ---
# Например, локальный порт вашего VPN/прокси-клиента (v2rayN: 10809, Clash: 7890, Nekoray: 2080)
GEMINI_PROXY=http://127.0.0.1:7890

# --- Раздельная маршрутизация браузера (VPN / Прокси для опросников РФ) ---
# BROWSER_PROXY: явный прокси для браузера (например, российский мобильный или резидентский прокси)
# BROWSER_PROXY=http://user:password@proxy-ru.net:8080
# BROWSER_DIRECT: если true, Chromium игнорирует системный прокси Windows (--no-proxy-server)
BROWSER_DIRECT=false
# Проверять ли геолокацию и IP браузера при старте бота
CHECK_BROWSER_IP=true

# --- Защита от антифрода (Human-like delays) ---
# Адаптивное время чтения вопросов (задержка пропорциональна количеству слов) и плавное движение мыши
HUMAN_LIKE_DELAYS=true

# --- Настройки браузера Playwright ---
BROWSER_HEADLESS=false
BROWSER_WIDTH=1600
BROWSER_HEIGHT=1200
E2E_SERVER_PORT=8888

# --- Telegram-уведомления ---
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321
